void mediaQuery() : {}
{
  ( mediaModifier()
    medium()
    ( LOOKAHEAD(1) ( <S> ) )*
    ( <AND_SYM>
      ( LOOKAHEAD(1) ( <S> ) )*
      mediaExpr()
    )*
  | mediaExpr()
    ( <AND_SYM>
      ( LOOKAHEAD(1) ( <S> ) )*
      mediaExpr()
    )*
