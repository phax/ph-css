void mediaModifier() : {}
{
  ( <ONLY_SYM> { jjtThis.setText (token.image); }
    <S>
  | <NOT_SYM>  { jjtThis.setText (token.image); }
    <S>
  )?
}

void medium() : {}
{
  <IDENT> { jjtThis.setText (token.image); }
}

void mediaFeature() : {}
{
  <IDENT>  { jjtThis.setText (token.image); }
}

void mediaExpr() : {}
{
  <LROUND>
  ( LOOKAHEAD(1) ( <S> ) )*
  mediaFeature()
  ( LOOKAHEAD(1) ( <S> ) )*
  ( <COLON>
    ( LOOKAHEAD(1) ( <S> ) )*
    expr()
  )?
  <RROUND>
  ( LOOKAHEAD(1) ( <S> ) )*
