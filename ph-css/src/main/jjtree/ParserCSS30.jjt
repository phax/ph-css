void supportsRule() : {}
{
  <SUPPORTS_SYM>
  ( LOOKAHEAD(1) ( <S> ) )*
  supportsCondition()
  ( LOOKAHEAD(1) ( <S> ) )*
  supportsRuleBody()
}

void propertyRuleSimpleExpressionTerm() #exprterm :
{ String sStr; }
{
  ( sStr = string()
  | sStr = booleanOperator()
  )
  {
    if (sStr != null)
      jjtThis.setText (sStr);
  }
}

void propertyRuleSimpleExpression() #expr : {}
{
  propertyRuleSimpleExpressionTerm()
}

void propertyRuleExpression() #void : {}
{
  // Both alternatives can start with a string, so the first one used to win unconditionally and
  // swallow just the leading term: "initial-value: \"foo\" bar" left "bar" behind and the rule then
  // came out with two children, which CSSNodeToDomainObject rejects. Take the single term form only
  // when that term really is the whole value; anything longer is an ordinary expression.
  ( LOOKAHEAD( propertyRuleSimpleExpressionTerm() ( <S> )* ( <SEMICOLON> | <RBRACE> ) )
    propertyRuleSimpleExpression()
  | expr()
  )
}

void propertyRuleInvalidDeclaration() #void :
{ Token prevToken = token; }
{
try {
  ( <IDENT>
  | LOOKAHEAD(( <ASTERISK> | <DOLLAR> ) <IDENT> )
    ( <ASTERISK> | <DOLLAR> ) { prevToken = token; }
    <IDENT>
  )
  {
    throw new ParseException (prevToken,
                              new int[][] {
                                new int[] { SYNTAX_SYM },
                                new int[] { INHERITS_SYM },
                                new int[] { INITIALVALUE_SYM }
                              },
                              tokenImage,
                              token_source == null ? null : ParserCSS30TokenManager.lexStateNames[token_source.curLexState]);
  }
} catch (/*final*/ ParseException ex) {
  if (m_bBrowserCompliantMode)
    browserCompliantSkipDecl (ex);
  else {
    errorSkipTo (ex, SEMICOLON);
    token_source.backup(1);
  }
}
}

void propertyRuleDescriptor() : {}
{
  ( <SYNTAX_SYM> { jjtThis.setText (token.image); }
  | <INHERITS_SYM> { jjtThis.setText (token.image); }
  | <INITIALVALUE_SYM> { jjtThis.setText (token.image); }
  )
  ( LOOKAHEAD(1) ( <S> ) )*
}

void propertyRuleDeclaration() : {}
{
  propertyRuleDescriptor()
  <COLON>
  ( LOOKAHEAD(1) ( <S> ) )*
  propertyRuleExpression()
}

void propertyRuleDeclarationOrInvalid() #void : {}
{
  ( propertyRuleDeclaration()
  | propertyRuleInvalidDeclaration()
  )
  ( LOOKAHEAD(1) ( <S> | <CDO> | <CDC> ) )*
}

CSSNode propertyRuleDeclarationList() : {}
{
try {
  ( LOOKAHEAD(1) ( <S> ) )*
  ( propertyRuleDeclarationOrInvalid() )?
  (
    <SEMICOLON>
    ( LOOKAHEAD(1) ( <S> ) )*
    ( propertyRuleDeclarationOrInvalid() )?
  )*
} catch (/*final*/ ParseException ex) {
  if (m_bBrowserCompliantMode)
    browserCompliantSkipDecl (ex);
  else {
    errorSkipTo (ex, RBRACE);
    token_source.backup(1);
  }
}
  { return jjtThis; }
}

void propertyRule() : {}
{
  <PROPERTY_SYM>
  ( LOOKAHEAD(1) ( <S> ) )*
