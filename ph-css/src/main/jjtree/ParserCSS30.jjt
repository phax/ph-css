void keyframesBlocks() #void : {}
{
  ( keyframesSelector()
    ( LOOKAHEAD(1) ( <S> ) )*
    styleDeclarationBlock()
    ( LOOKAHEAD(1) ( <S> ) )*
  )*
}

void keyframesRule() : {}
{
  <KEYFRAMES_SYM> { jjtThis.setText (token.image); }
  <S>
  keyframesIdentifier()
  ( LOOKAHEAD(1) ( <S> ) )*
