// pseudo_page+ | IDENT pseudo_page*
void pageSelector() :
{ String s; }
{
  ( s = pseudoPage() { jjtThis.setText (s); }
  | <IDENT>          { jjtThis.setText (token.image); }
  )
  ( s = pseudoPage() { jjtThis.appendText (s); } )*
  ( LOOKAHEAD(1) ( <S> ) )*
