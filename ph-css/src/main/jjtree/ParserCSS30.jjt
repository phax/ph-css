}


//
// Generic utility rules
//
String string() #void : {}
{
  ( <STRING1>
  | <STRING2>
  )
  { return token.image; }
}

String anyIdentifier() #void : {}
{
  ( <IDENT>
  | <INHERIT>
  | <AND_SYM>
  | <NOT_SYM>
  | <ONLY_SYM>
  | <FROM_SYM>
  | <TO_SYM>
  | <OR_SYM>
  )
  { return token.image; }
}

String booleanOperator() #void : {}
{
  ( <TRUE_SYM> 
  | <FALSE_SYM>
  )
  { return token.image; }
}

void url() : {}
{
  <URL>  { jjtThis.setText (token.image); }
}

void function() :
{ String sPlain; }
{
  ( <FUNCTION> { jjtThis.setText (token.image + ")"); }
    ( LOOKAHEAD(1) ( <S> ) )*
    // Support functions without parameters (e.g. "gray ()")
    ( expr() )?
    <RROUND>
  | <FUNCTION_EXPRESSION> { jjtThis.setText (token.image); }
    // get content of all skipped chars
    sPlain = javaSkipToClosingParantheses() { jjtThis.appendText (sPlain); }
  )
}

String unaryOperator() #void : {}
{
  ( <MINUS>
  | <PLUS>
  )
  { return token.image; }
}

Token dimension() #void :
{ Token t; }
{
  ( t = <DIMENSION>
  )
  { return t; }
}

void calcValue() :
{
  String sPrefix = null;
  Token t = null;
}
{
  ( sPrefix = unaryOperator() )?
  ( t = <NUMBER>
  | t = <PERCENTAGE>
  | t = dimension()
  | t = <IDENT>
  | function()
  | calc()
  | <LROUND>
    ( LOOKAHEAD(1) ( <S> ) )*
    calcSum()
    ( LOOKAHEAD(1) ( <S> ) )*
    <RROUND>
  )
  {
    if (sPrefix != null)
      jjtThis.appendText (sPrefix);
    if (t != null)
      jjtThis.appendText (t.image);
  }
}

void calcProductOperator() : {}
{
  <ASTERISK> { jjtThis.setText ("*"); }
| <SLASH>    { jjtThis.setText ("/"); }
}

void calcProduct() : {}
{
  calcValue()
  ( LOOKAHEAD(2)
    ( LOOKAHEAD(1) ( <S> ) )*
    calcProductOperator()
    ( LOOKAHEAD(1) ( <S> ) )*
    calcValue()
  )*
}

void calcSumOperator() : {}
{
  ( <PLUS>  { jjtThis.setText ("+"); }
  | <MINUS> { jjtThis.setText ("-"); }
  )
}

void calcSum() #void : {}
{
  calcProduct()
  ( LOOKAHEAD(2)
    ( LOOKAHEAD(1) ( <S> ) )*
    calcSumOperator()
    ( LOOKAHEAD(1) ( <S> ) )*
    calcProduct()
  )*
}

void calc() : {}
{
  <FUNCTION_CALC>
  ( LOOKAHEAD(1) ( <S> ) )*
  calcSum()
  ( LOOKAHEAD(1) ( <S> ) )*
  <RROUND>
}

// for css3-grid-layout
void lineName() : {}
{
  <IDENT> { jjtThis.setText (token.image); }
}

void lineNames() : {}
{
  <LSQUARE>
  ( LOOKAHEAD(1) ( <S> ) )*
  ( lineName()
    ( LOOKAHEAD(2)
      ( LOOKAHEAD(1) ( <S> ) )* 
      lineName()
    )*
    ( LOOKAHEAD(1) ( <S> ) )*
  )?
  <RSQUARE>
}

void exprTerm() :
{
  String sPrefix = null;
  Token t = null;
}
{
  ( ( sPrefix = unaryOperator() )?
    ( t = <NUMBER>
    | t = <PERCENTAGE>
    | t = dimension()
    )
  | sPrefix = string()
// Hack to allow "from" and "to" as identifiers (e.g. in linear-gradient)
// Also allow "or" as parameter to "x:lang(no)"
  | sPrefix = anyIdentifier()
  | url()
  | t = <HASH>
  | function()
  | calc()
  | t = <URANGE>
  | lineNames()
  )
  ( LOOKAHEAD(1) ( <S> ) )*
  {
    if (sPrefix != null)
      jjtThis.appendText (sPrefix);
    if (t != null)
      jjtThis.appendText (t.image);
  }
}

void exprOperator() : {}
{
  ( <SLASH>  { jjtThis.setText ("/"); }
  | <COMMA>  { jjtThis.setText (","); }
  /* Extension for Microsoft filters (alpha=50) */
  | <EQUALS> { jjtThis.setText ("="); }
  )
}

void expr() : {}
{
  // No leading ( <S> )* inside the loop: exprTerm() already ends with one, so at this point the
  // current token can never be <S>. It used to be here, and because <S> can also follow expr() in
  // the callers it was the last remaining choice conflict in this grammar - a conflict over input
  // that cannot occur.
  exprTerm()
  // LOOKAHEAD(1) for the same reason as everywhere else in this grammar: a term may begin with a
  // unary "+", and "+" is also in the follow set of expr(), so the loop overlaps with what comes
  // after it. Greedy is right - in "margin: 1px +2px" the second term belongs to this expression.
  ( LOOKAHEAD(1)
    ( exprOperator()
      ( LOOKAHEAD(1) ( <S> ) )*
    )?
    exprTerm()
  )*
}

//
// Charset rule
//
void charsetRule() :
{ String sStr; }
{
  <CHARSET_SYM>
  ( LOOKAHEAD(1) ( <S> ) )+
  sStr = string() { jjtThis.setText (sStr); }
  ( LOOKAHEAD(1) ( <S> ) )*
  <SEMICOLON>
}

//
// Import rule
//
void importRule() :
{ String sUrl; }
{
  <IMPORT_SYM>
  ( LOOKAHEAD(1) ( <S> ) )*
  ( sUrl = string() { jjtThis.setText (sUrl); }
  | url()
  )
  ( LOOKAHEAD(1) ( <S> ) )*
  ( mediaList() )?
  <SEMICOLON>
}

//
// Namespace rule
//
void namespaceRulePrefix() : {}
{
  <IDENT> { jjtThis.setText (token.image); }
}

void namespaceRuleURL() :
{ String s; }
{
  // URL tokens are always passed without the quotes!
  ( <URL>        { jjtThis.setText (token.image); }
  | s = string() { jjtThis.setText (CSSParseHelper.unescapeURL (s)); }
  )
}

void namespaceRule() : {}
{
  <NAMESPACE_SYM>
  ( LOOKAHEAD(1) ( <S> ) )*
  ( namespaceRulePrefix()
    ( LOOKAHEAD(1) ( <S> ) )*
  )?
  namespaceRuleURL()
  ( LOOKAHEAD(1) ( <S> ) )*
  <SEMICOLON>
}

//
// Style rule
//
void namespacePrefix() : {}
{
  ( <IDENT>    { jjtThis.setText (token.image); }
  | <ASTERISK> { jjtThis.setText (token.image); }
  )?
  <DASH>        { jjtThis.appendText ("|"); }
}

void elementName() : {}
{
  ( <IDENT>    { jjtThis.setText (token.image); }
  | <ASTERISK> { jjtThis.setText (token.image); }
  )
}

void typeSelector() #void : {}
{
  ( LOOKAHEAD(2)
    namespacePrefix()
  )?
  elementName()
}

void nestingSelector() #Nesting : {}
{
  <AMPERSAND> { jjtThis.setText ("&"); }
}

void idSelector() : {}
{
  <HASH> { jjtThis.setText (token.image); }
}

void classSelector() #Class :
{ String sIdentifier; }
{
  <DOT>
  sIdentifier = anyIdentifier() { jjtThis.setText ("." + sIdentifier); }
}

void attribOperator() : {}
{
  ( <EQUALS>         { jjtThis.setText ("=");  }
  | <INCLUDES>       { jjtThis.setText ("~="); }
  | <DASHMATCH>      { jjtThis.setText ("|="); }
  | <PREFIXMATCH>    { jjtThis.setText ("^="); }  /* new in 3.0 */
  | <SUBFIXMATCH>    { jjtThis.setText ("$="); }  /* new in 3.0 */
  | <SUBSTRINGMATCH> { jjtThis.setText ("*="); }  /* new in 3.0 */
  )
}

void attribValue() :
{ String sStr; }
{
  ( <IDENT>         { jjtThis.setText (token.image); }
  | sStr = string() { jjtThis.setText (sStr); }
  )
}

void attribCase() : {}
{
  ( <IDENT>
    {
      final String v = token.image;
      if ("i".equalsIgnoreCase (v) || "s".equalsIgnoreCase (v))
        jjtThis.setText (v.toLowerCase (java.util.Locale.ROOT));
      else
        throw new ParseException ("Invalid case-sensitivity flag '" + v + "'. Only 'i' or 's' are allowed.");
    }
  )?
}

void attributeSelector() : {}
{
  <LSQUARE>
  ( LOOKAHEAD(1) ( <S> ) )*
  ( LOOKAHEAD(2)
    namespacePrefix()
  )?
  <IDENT> { jjtThis.setText (token.image); }
  /* Hack for html[xmlns*=""] */
  ( <ASTERISK> { jjtThis.appendText ("*"); } )?
